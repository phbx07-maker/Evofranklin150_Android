<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061426">

    <LinearLayout
        android:id="@+id/desktop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EvoFranklin"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM READY"
                    android:textColor="#58D68D"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="CONNECT"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1473E6" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp"
            android:text="HOME"
            android:textColor="#8EACCF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3">

            <Button
                android:id="@+id/btnPhone"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="Virtual Phone"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1473E6" />

            <Button
                android:id="@+id/btnBrowser"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="Browser"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16416E" />

            <Button
                android:id="@+id/btnApk"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="Install APK"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16416E" />

            <Button
                android:id="@+id/btnWhatsapp"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="WhatsApp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16416E" />

            <Button
                android:id="@+id/btnFacebook"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="Facebook"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16416E" />

            <Button
                android:id="@+id/btnInstagram"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="Instagram"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16416E" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="Settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16416E" />

        </GridLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EVOFRANKLIN 150 - ANDROID DESKTOP"
            android:textColor="#607D9F"
            android:textSize="11sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#030810">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="70dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="15dp"
            android:text="HOME"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1473E6" />

    </FrameLayout>

</FrameLayout>